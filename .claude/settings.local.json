{
  "permissions": {
    "allow": [
      "Bash(docker exec:*)",
      "Bash(docker ps:*)",
      "Bash(python ingestion/extract_prices.py)",
      "Bash(python3 ingestion/extract_prices.py)",
      "Bash(find . -name *.cfg -o -name *.toml -o -name *.txt -o -name Pipfile -o -name *.lock)",
      "Bash(python3 -m venv /tmp/stock_venv)",
      "Bash(/tmp/stock_venv/bin/pip install:*)",
      "Bash(/tmp/stock_venv/bin/python ingestion/extract_prices.py)",
      "Bash(mkdir -p /tmp/airflow_data)",
      "Bash(DUCKDB_PATH=/tmp/airflow_data/stock_pipeline.duckdb /tmp/stock_venv/bin/python ingestion/extract_prices.py)"
    ]
  }
}
