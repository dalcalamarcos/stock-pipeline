FROM python:3.12-slim

WORKDIR /app

COPY requirements.api.txt .
RUN pip install --no-cache-dir -r requirements.api.txt

COPY models/ ./models/
COPY api/ ./api/

ENV DUCKDB_PATH=/app/data/stock_pipeline.duckdb
ENV PYTHONPATH=/app

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
